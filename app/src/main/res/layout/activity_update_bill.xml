<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="BILKU  /  EDITOR"
            android:textColor="@color/pastel_yellow"
            android:textSize="12sp"
            android:letterSpacing="0.18"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Edit Statement"
            android:textColor="@color/soft_white"
            android:textSize="34sp"
            android:fontFamily="serif"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Refine the details of your electricity statement."
            android:textColor="@color/muted_text"
            android:textSize="14sp"
            android:fontFamily="@font/nunito"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:background="@color/line_soft"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STATEMENT INFORMATION"
            android:textColor="@color/pastel_yellow"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="22dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Billing Month"
            android:textColor="@color/pastel_yellow"
            android:textSize="15sp"
            android:fontFamily="@font/nunito_bold"
            android:layout_marginBottom="10dp"/>

        <Spinner
            android:id="@+id/spinnerMonth"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Electricity Usage (kWh)"
            android:textColor="@color/pastel_yellow"
            android:textSize="15sp"
            android:fontFamily="@font/nunito_bold"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/editTextUnit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input"
            android:hint="Enter units (1 - 1000)"
            android:inputType="number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/soft_white"
            android:textColorHint="@color/field_hint"
            android:textSize="16sp"
            android:fontFamily="@font/nunito"
            android:layout_marginBottom="26dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rebate Percentage"
                android:textColor="@color/pastel_yellow"
                android:textSize="15sp"
                android:fontFamily="@font/nunito_bold"/>

            <TextView
                android:id="@+id/textViewRebate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/soft_white"
                android:textSize="20sp"
                android:fontFamily="@font/nunito_bold"/>

        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBarRebate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5"
            android:progress="0"
            android:progressTint="@color/pastel_yellow"
            android:progressBackgroundTint="@color/line_soft"
            android:thumbTint="@color/pastel_yellow"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0%"
                android:textColor="@color/muted_text"
                android:textSize="12sp"
                android:fontFamily="@font/nunito"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5%"
                android:textColor="@color/muted_text"
                android:textSize="12sp"
                android:fontFamily="@font/nunito"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A NOTE ON YOUR STATEMENT"
                android:textColor="#756654"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your revised electricity charges will be recalculated based on the updated usage and rebate percentage."
                android:textColor="#352F28"
                android:textSize="14sp"
                android:fontFamily="@font/nunito"
                android:lineSpacingExtra="4dp"
                android:justificationMode="inter_word"/>

        </LinearLayout>

        <Button
            android:id="@+id/buttonUpdate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/pastel_yellow"
            android:text="Update Statement"
            android:textAllCaps="false"
            android:textColor="@color/purple_dark"
            android:textSize="16sp"
            android:fontFamily="@font/nunito_bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/purple_card"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/soft_white"
            android:textSize="16sp"
            android:fontFamily="@font/nunito_bold"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="BILKU  ·  EST. 2026"
            android:textColor="@color/muted_text"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="14dp"/>

    </LinearLayout>
</ScrollView>
