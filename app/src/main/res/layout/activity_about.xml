<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="BILKU  /  INFORMATION"
            android:textColor="@color/pastel_yellow"
            android:textSize="12sp"
            android:letterSpacing="0.16"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="About BilKu"
            android:textColor="@color/soft_white"
            android:textSize="34sp"
            android:fontFamily="serif"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="The application and its developer."
            android:textColor="@color/muted_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line_soft"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="DEVELOPER PROFILE"
                android:textColor="#756654"
                android:textSize="11sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="20dp"/>

            <ImageView
                android:id="@+id/imageViewProfile"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="18dp"
                android:src="@drawable/student_photo"
                android:scaleType="centerCrop"
                android:contentDescription="Student profile picture"/>

            <TextView
                android:id="@+id/textViewStudentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NUR ALLYSYA ADEERA BINTI RANIL AHMAL"
                android:textColor="#352F28"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <View
                android:layout_width="70dp"
                android:layout_height="1dp"
                android:background="#A68C69"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/textViewStudentId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student ID: 2024235702"
                android:textColor="#625447"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ICT602 - Mobile Technology and Development"
                android:textColor="#625447"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:gravity="center"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01  /  THE APPLICATION"
            android:textColor="@color/pastel_yellow"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About the Application"
            android:textColor="@color/soft_white"
            android:textSize="25sp"
            android:fontFamily="serif"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BilKu is an Android application designed to estimate monthly electricity bills based on electricity consumption and rebate percentage. The application calculates charges using a block-based tariff structure and displays the total charges and final cost after rebate. It also uses an offline SQLite database to store electricity bill records, allowing users to view, update, and delete previously saved information."
            android:textColor="@color/soft_white"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="28dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line_soft"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="02  /  USER GUIDE"
            android:textColor="@color/pastel_yellow"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to Use BilKu"
            android:textColor="@color/soft_white"
            android:textSize="25sp"
            android:fontFamily="serif"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Open BilKu and select the desired month from January to December."
            android:textColor="@color/soft_white"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Enter the number of electricity units consumed in kilowatt-hours (kWh). The value must be between 1 and 1000."
            android:textColor="@color/soft_white"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Adjust the rebate slider to select a rebate percentage between 0% and 5%."
            android:textColor="@color/soft_white"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Tap Calculate Bill to calculate the electricity charges and display the final cost after rebate."
            android:textColor="@color/soft_white"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. The calculated bill will automatically be saved in the local SQLite database."
            android:textColor="@color/soft_white"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="6. Tap View Bill History to display previously saved electricity bills. The list displays the month and final cost."
            android:textColor="@color/soft_white"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="7. Select any saved bill to view its complete information, including the month, electricity usage, total charges, rebate percentage, and final cost."
            android:textColor="@color/soft_white"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="8. Tap Edit Statement to modify the month, electricity usage, or rebate percentage. The application will recalculate the charges and update the existing record."
            android:textColor="@color/soft_white"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="9. Tap Delete Statement to remove a saved bill. A confirmation dialog will appear before the record is permanently deleted."
            android:textColor="@color/soft_white"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="28dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line_soft"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="03  /  ONLINE REPOSITORY"
            android:textColor="@color/pastel_yellow"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Application Website"
            android:textColor="@color/soft_white"
            android:textSize="25sp"
            android:fontFamily="serif"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:id="@+id/textViewWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visit BilKu on GitHub"
            android:textColor="@color/pastel_yellow"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/pastel_yellow"
            android:text="Back to Calculator"
            android:textAllCaps="false"
            android:textColor="@color/purple_dark"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2026 NUR ALLYSYA ADEERA BINTI RANIL AHMAL. All rights reserved."
            android:textColor="@color/muted_text"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BILKU  ·  EST. 2026"
            android:textColor="@color/muted_text"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
